# TrashTheTest frontend - environment template.
# Copy to .env and adjust for your backend URL. NEVER commit real secrets.
# VITE_* vars are baked in at dev-server start / build time, so restart
# `pnpm dev` (or rebuild the compose frontend service) after changing them.
# PORT / BASE_PATH are read by vite.config.ts (defaults: 3000 / /).

# Backend API base URL (FastAPI). Compose default served on host port 8000.
VITE_API_BASE_URL=http://localhost:8000

# localStorage key for the auth token.
VITE_AUTH_TOKEN_KEY=trash_the_test_token

# Browser tab / header title.
VITE_APP_TITLE=TrashTheTest

# Optional heavy-document path (default OFF; explicit user gesture only).
VITE_PUTER_ENABLED=false
VITE_PUTER_HEAVY_PAGE_THRESHOLD=100

# Dev-server port. Compose sets PORT=5173 to match the 5173:5173 mapping.
PORT=5173
BASE_PATH=/
