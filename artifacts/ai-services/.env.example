# TrashTheTest AI Services - environment template.
# Copy to .env and fill in real values. NEVER commit real secrets.
# Every variable below is read by config/settings.py; placeholders only.

# --- REQUIRED: fail-fast at boot when missing ---
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trashthetest

# --- Auth ---
JWT_ISSUER=trashthetest
JWT_AUDIENCE=trashthetest-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- CORS (explicit allowlist; '*' is refused when credentials are on) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Embeddings (1024d multilingual default, ADR-005) ---
EMBEDDING_PROVIDER=qwen3-embedding
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./.cache/embeddings

# --- Rerank ---
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM router (model ids from config only; no literals in service code) ---
LLM_PROVIDER=groq
LLM_PRIMARY=qwen/qwen3-32b
LLM_FALLBACK=openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --- OCR (PP-OCRv6 CPU ONNX tiny det/rec; single local path) ---
OCR_PROVIDER=ppocr-onnx
OCR_DET_MODEL=PP-OCRv6_mobile_det_tiny
OCR_REC_MODEL=PP-OCRv6_mobile_rec_tiny
OCR_ENGINE=onnxruntime
OCR_DEVICE=cpu
OCR_LANG=en
# --- Puter (optional heavy-document path; default OFF) ---
PUTER_ENABLED=false
PUTER_HEAVY_PAGE_THRESHOLD=100

# --- Worker / jobs (Postgres SKIP LOCKED is the single truth; Redis/Celery optional dispatch) ---
WORKER_CONCURRENCY=2
JOB_LOCK_TIMEOUT_SECONDS=600
REDIS_URL=redis://localhost:6379/0

# --- Rate limits ---
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=false
APP_ENV=dev

# --- Legacy / optional provider keys ---
LLM_MODEL=
LLM_API_KEY=
TAVILY_API_KEY=
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily
SEARCH_ENABLED=false
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_sarah
